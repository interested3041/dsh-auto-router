{
  "name": "dsh-bailian-auto-router",
  "version": "0.1.0",
  "description": "DeepSeek Harness 百炼智能路由插件:注册虚拟模型 bailian-auto,在每次请求前由决策模型分析输入的模态与任务类型,自动路由到最合适的阿里云百炼执行模型;内置额度感知、冷却回退与失败静默切换。Decision-model router for Aliyun Bailian (DashScope): registers the virtual model bailian-auto, analyzes each request with a decision model, routes to the best execution model with quota-aware cooldown and silent fallback.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.host.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "src",
    "types",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "tsconfig.json",
    "README.md",
    "LICENSE",
    "scripts",
    "test",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node test/smoke.mjs",
    "test": "node test/smoke.mjs && node test/classify.test.mjs && node test/router.test.mjs && node test/account.test.mjs && node test/behavior.test.mjs",
    "test:live": "node test/live.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@types/node": "^24.9.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "bailian",
    "dashscope",
    "aliyun",
    "qwen",
    "router",
    "llm",
    "fallback"
  ],
  "author": "interested3041",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interested3041/dsh-bailian-auto-router.git"
  },
  "homepage": "https://github.com/interested3041/dsh-bailian-auto-router#readme",
  "bugs": {
    "url": "https://github.com/interested3041/dsh-bailian-auto-router/issues"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ]
}
